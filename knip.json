{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts!",
    "relay/src/worker.ts!",
    "src/**/__tests__/**/*.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "scripts/**/*.ts!",
    "relay/src/**/*.ts!"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/engine/types/manifest.ts": ["exports", "types"],
    "src/engine/quest/types.ts": ["exports"]
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "duplicates": "off",
    "exports": "error",
    "types": "error"
  }
}
