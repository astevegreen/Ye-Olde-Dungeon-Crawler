{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git -C C:/Antigravity/YODC-integrate push origin HEAD:main)",
      "Bash(npm run sonar:*)",
      "Bash(gh run cancel:*)",
      "Bash(node C:/Antigravity/YODC/scripts/sprint/queue.mjs *)",
      "PowerShell(node C:/Antigravity/YODC/scripts/sprint/queue.mjs *)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push *--no-verify*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push *+*)",
      "Bash(git -C * push *--delete*)",
      "Bash(git -C * push -d *)",
      "Bash(git -C * push * -d *)",
      "Bash(git -C * push *--no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean -*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git branch -D*)",
      "Bash(git -C * branch -D*)",
      "Bash(git tag -d*)",
      "Bash(git -C * tag -d*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * commit -n*)",
      "Bash(git *core.hooksPath*)",
      "Bash(*SKIP_HOOKS*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push -d *)",
      "PowerShell(git push * -d *)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git -C * push *--force*)",
      "PowerShell(git -C * push -f*)",
      "PowerShell(git -C * push * -f*)",
      "PowerShell(git -C * push *+*)",
      "PowerShell(git -C * push *--delete*)",
      "PowerShell(git -C * push -d *)",
      "PowerShell(git -C * push * -d *)",
      "PowerShell(git -C * push *--no-verify*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git -C * reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git -C * clean -*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git filter-repo*)",
      "PowerShell(git tag -d*)",
      "PowerShell(git -C * tag -d*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git -C * commit *--no-verify*)",
      "PowerShell(git -C * commit -n*)",
      "PowerShell(git *core.hooksPath*)",
      "PowerShell(*SKIP_HOOKS*)"
    ],
    "deny": [
      "Read(dist/**)",
      "Read(node_modules/**)",
      "Read(playwright-report/**)",
      "Read(test-results/**)",
      "Read(*.log)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lockfile-read.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/handoff-nudge.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage-limit-wake.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.mjs",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node .claude/hooks/handoff-nudge.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
