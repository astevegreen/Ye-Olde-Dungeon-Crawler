{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git push)",
      "Bash(git push origin main)"
    ],
    "deny": [
      "Read(dist/**)",
      "Read(node_modules/**)",
      "Read(package-lock.json)",
      "Read(playwright-report/**)",
      "Read(test-results/**)",
      "Read(*.log)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/handoff-nudge.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.mjs",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node .claude/hooks/handoff-nudge.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
