{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "permissions": {
    "deny": [
      "Read(dist/**)",
      "Read(node_modules/**)",
      "Read(package-lock.json)",
      "Read(playwright-report/**)",
      "Read(test-results/**)",
      "Read(*.log)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
