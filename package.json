{
  "name": "castle-of-the-winds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cotw": "tsc && vite build --mode cotw",
    "build:warcraft": "tsc && vite build --mode warcraft",
    "build:all": "npm run build:cotw && npm run build:warcraft",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test:e2e": "playwright test --",
    "test:record": "playwright test e2e/gameplay-record.spec.ts --project=chromium",
    "test:campaign": "playwright test e2e/campaign-flow.spec.ts --project=chromium",
    "lint": "tsc --noEmit && npm run check:engine-purity && npm run check:engine-encapsulation && npm run check:engine-creep && npm run knip",
    "knip": "knip",
    "check:engine-purity": "tsx scripts/check-engine-purity.ts",
    "check:engine-encapsulation": "tsx scripts/check-engine-encapsulation.ts",
    "check:engine-creep": "tsx scripts/check-engine-creep.ts",
    "sim": "npx tsx scripts/headless-sim.ts",
    "validate:schema": "npx tsx scripts/validate-schema.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "knip": "^6.35.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.4.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
