{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/engine/index.ts!",
    "src/content/cotw/index.ts!",
    "src/content/warcraft/index.ts!",
    "scripts/*.ts!",
    "relay/src/worker.ts!",
    "src/**/__tests__/**/*.ts!"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "relay/src/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "duplicates": "off",
    "exports": "error",
    "types": "error"
  }
}
