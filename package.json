{
  "name": "castle-of-the-winds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cotw": "tsc && vite build --mode cotw",
    "build:warcraft": "tsc && vite build --mode warcraft",
    "build:all": "npm run build:cotw && npm run build:warcraft",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit && npm run check:engine-purity",
    "check:engine-purity": "tsx scripts/check-engine-purity.ts",
    "sim": "npx tsx scripts/headless-sim.ts",
    "validate:schema": "npx tsx scripts/validate-schema.ts"
  },
  "devDependencies": {
    "knip": "^6.35.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.7"
  }
}
