#!/bin/sh
# Pre-push gate (ARCHITECTURE.md §7.2).
#
# Commits land directly on main, and CI's full gate run (.github/workflows/)
# happens only after a push, so the gates that pre-commit skips for speed run
# here, before anything reaches origin: the tooling tests, the headless sim,
# schema validation, the cotw bundle, and the Playwright suite against the built
# bundle. (About two minutes, see docs/architecture/quality-gates.md; pre-commit
# has already run lint and the unit tests.)
#
# A push that updates only the `handoffs` branch carries handoff notes and no code
# (.claude/skills/handoff/notes.mjs), so it runs no gate.
#
# While a sprint window is open, a push to main from anywhere but the integrator's
# worktree is refused (scripts/sprint/push-lock.mjs).
#
# Set SKIP_HOOKS=1 to bypass the gates deliberately, as with the other hooks; it
# does not lift the sprint lock.
set -e

# stdin lists one line per ref the push updates: <local ref> <local sha> <remote ref> <remote sha>.
refs=$(cat)
printf '%s\n' "$refs" | node "$(dirname "$0")/../scripts/sprint/push-lock.mjs"

if [ "$SKIP_HOOKS" = "1" ]; then
  echo "pre-push: skipped (SKIP_HOOKS=1)"
  exit 0
fi

handoff_refs=0
other_refs=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = refs/heads/handoffs ]; then handoff_refs=1; else other_refs=1; fi
done <<EOF
$refs
EOF
if [ "$handoff_refs" = 1 ] && [ "$other_refs" = 0 ]; then
  echo "pre-push: handoff notes only, no gates"
  exit 0
fi

# Pre-commit skips these when the tooling is unchanged, but a game change can break one too.
echo "pre-push: npm run test:tooling"
npm run test:tooling

echo "pre-push: npm run sim"
npm run sim

echo "pre-push: npm run validate:schema"
npm run validate:schema

echo "pre-push: npm run build"
npm run build

# Local runs elsewhere use Chromium only (playwright.config.ts); the push runs all three browsers.
# One retry, as CI has two: a test that fails and then passes is reported as flaky and
# does not block the push; a test that fails twice does.
echo "pre-push: PW_ALL_BROWSERS=1 npx playwright test --retries=1"
PW_ALL_BROWSERS=1 npx playwright test --retries=1

echo "pre-push: passed"
