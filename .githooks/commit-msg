#!/bin/sh
# Commit-message gate (ARCHITECTURE.md §8.1, §8.4).
#
# 1. A commit that stages a §8.1 protected file must name its exception in the
#    message, e.g. "§8.1 exception 1". The pre-commit gates check what the code
#    does; this makes every protected-file edit a stated, reviewable decision.
# 2. Rejects a message carrying an "Agent: Antigravity" line (§8.4): Antigravity
#    is read-only and never commits. A tripwire, not enforcement: both tools
#    commit as the same git user, so only a labeled commit is caught.
# 3. Warns (never blocks) when a large commit spans several areas: one request
#    per commit keeps after-the-fact review and reverts cheap.
#
# Set SKIP_HOOKS=1 to bypass deliberately, as with pre-commit.
set -e

if [ "$SKIP_HOOKS" = "1" ]; then
  exit 0
fi

MSG_FILE="$1"
# Ignore git's comment lines when reading the message.
MSG=$(grep -v '^#' "$MSG_FILE" || true)

PROTECTED='^src/engine/actions/actionPipeline\.ts$|^src/engine/engine\.ts$|^src/engine/storage/migrator\.ts$'
STAGED_PROTECTED=$(git diff --cached --name-only | grep -E "$PROTECTED" || true)

if [ -n "$STAGED_PROTECTED" ]; then
  if ! printf '%s\n' "$MSG" | grep -Eq '§8\.1 exception [1-4]'; then
    echo "commit-msg: this commit changes a §8.1 protected file:" >&2
    printf '  %s\n' $STAGED_PROTECTED >&2
    echo "State the exception in the message, e.g. \"§8.1 exception 1\" (ARCHITECTURE.md §8.1)." >&2
    exit 1
  fi
fi

if printf '%s\n' "$MSG" | grep -Eq '^Agent: Antigravity'; then
  echo "commit-msg: Antigravity is read-only and doesn't commit; it writes reports to .prompts/antigravity/ (ARCHITECTURE.md §8.4)." >&2
  exit 1
fi

# Large commit spanning several areas: likely several requests bundled together.
AREAS=$(git diff --cached --name-only | sed -E 's#^(src/[^/]+|[^/]+)/.*#\1#' | sort -u | wc -l | tr -d ' ')
CHANGED=$(git diff --cached --numstat | awk '{ s += $1 + $2 } END { print s + 0 }')
if [ "$AREAS" -ge 4 ] && [ "$CHANGED" -ge 1500 ]; then
  echo "commit-msg: warning: $CHANGED changed lines across $AREAS areas. If this bundles several requests," >&2
  echo "split it: one request per commit (ARCHITECTURE.md §8.4)." >&2
fi
